---
import { getCollection, render } from "astro:content";
import PostThumbnail from "@components/blog/PostThumbnail.astro";
import { formatBlogDate } from "@components/blog/blogHelpers";
import ArrowRight from "/public/images/arrow-right.svg";
import MainLayout from "../../layouts/MainLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const hasVideo = Boolean(data.video);
---

<MainLayout
  canonicalUrl={`https://smelter.dev/blog/${entry.id}`}
  title={`${data.title} — Smelter Blog`}
  description={data.description}
>
  <main class="flex min-h-screen w-full justify-center overflow-x-clip">
    <div class="relative w-full max-w-[1536px]">
      <article class="px-4 pb-28 pt-24 sm:px-8 sm:pt-28">
        <div class="mx-auto flex max-w-[760px] flex-col">
          <a
            href="/blog"
            class="mono mb-8 inline-flex w-fit items-center gap-2 text-[11px] uppercase tracking-[0.14em] text-hero-subtitle no-underline transition-colors hover:text-white"
          >
            <ArrowRight class="h-3.5 w-3.5 rotate-180" />
            Blog
          </a>
          <h1 class="mb-5 text-white">{data.title}</h1>
          <p class="par-l mb-6 text-hero-subtitle">{data.description}</p>
          <p
            class="mono mb-10 text-[11px] uppercase tracking-[0.12em] text-hero-subtitle"
          >
            {formatBlogDate(data.date)} · {data.author}
          </p>

          <PostThumbnail
            cover={data.cover}
            alt={data.title}
            hasVideo={hasVideo}
            duration={data.duration}
            playSize="lg"
            loading="eager"
            class="mb-10 aspect-video w-full rounded-3xl border border-homeLicense-border"
          />

          {
            hasVideo && (
              <a
                href={data.video}
                target="_blank"
                rel="noreferrer noopener"
                class="bg-[#F24664] hover:bg-[#F5546E] mb-12 flex h-12 w-fit items-center gap-x-2 rounded-full px-5 text-white no-underline transition-all duration-300 hover:scale-[1.02] hover:shadow-2xl hover:shadow-[#fbc6cf40]"
              >
                <span class="text-base">Watch the video</span>
                <ArrowRight class="h-4 w-4" />
              </a>
            )
          }

          <div class="blog-prose">
            <Content />
          </div>
        </div>
      </article>
    </div>
  </main>
</MainLayout>

<style>
  .mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
  }

  /* Article body — spacing + rhythm consistent with the rest of the site. */
  .blog-prose :global(p) {
    color: #c2b1e0;
    margin-bottom: 1.5rem;
  }
  .blog-prose :global(h2) {
    color: #fff;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .blog-prose :global(h3) {
    color: #fff;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .blog-prose :global(ul),
  .blog-prose :global(ol) {
    color: #c2b1e0;
    margin: 0 0 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .blog-prose :global(ul) {
    list-style: disc;
  }
  .blog-prose :global(ol) {
    list-style: decimal;
  }
  .blog-prose :global(li) {
    padding-left: 0.25rem;
  }
  .blog-prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .blog-prose :global(strong) {
    color: #fff;
    font-weight: 500;
  }
</style>
