---
import { getCollection, render } from "astro:content";
import {
  PUBLIC_GISCUS_CATEGORY,
  PUBLIC_GISCUS_CATEGORY_ID,
  PUBLIC_GISCUS_REPO,
  PUBLIC_GISCUS_REPO_ID,
} from "astro:env/server";
import { GiscusComments } from "@components/blog/GiscusComments";
import PostThumbnail from "@components/blog/PostThumbnail.astro";
import ShareBar from "@components/blog/ShareBar.astro";
import VideoEmbed from "@components/blog/VideoEmbed.astro";
import {
  formatBlogDate,
  postOgImage,
  postUrl,
  youtubeEmbedUrl,
} from "@components/blog/blogHelpers";
import ArrowRight from "/public/images/arrow-right.svg";
import MainLayout from "../../layouts/MainLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const hasVideo = Boolean(data.video);
// Non-YouTube (or unparseable) video URLs keep the old thumbnail + link out.
const embedUrl = data.video ? youtubeEmbedUrl(data.video) : null;

const canonicalUrl = postUrl(entry.id);
const ogImage = postOgImage(data.cover);

// Comments only render on deployments where Giscus is fully configured, so
// local dev and previews without the env vars simply skip the section.
const giscus =
  PUBLIC_GISCUS_REPO && PUBLIC_GISCUS_REPO_ID && PUBLIC_GISCUS_CATEGORY && PUBLIC_GISCUS_CATEGORY_ID
    ? {
        repo: PUBLIC_GISCUS_REPO,
        repoId: PUBLIC_GISCUS_REPO_ID,
        category: PUBLIC_GISCUS_CATEGORY,
        categoryId: PUBLIC_GISCUS_CATEGORY_ID,
      }
    : null;
---

<MainLayout
  canonicalUrl={canonicalUrl}
  title={`${data.title} — Smelter Blog`}
  description={data.description}
  ogUrl={canonicalUrl}
  ogImage={ogImage}
  ogImageAlt={ogImage ? data.title : undefined}
  ogType="article"
>
  <Fragment slot="head">
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Smelter Blog"
      href="/blog/rss.xml"
    />
  </Fragment>
  <main class="flex min-h-screen w-full justify-center overflow-x-clip">
    <div class="relative w-full max-w-[1536px]">
      <article class="px-4 pb-28 pt-24 sm:px-8 sm:pt-28">
        <div class="mx-auto flex max-w-[760px] flex-col">
          <a
            href="/blog"
            class="mono mb-8 inline-flex w-fit items-center gap-2 text-[11px] uppercase tracking-[0.14em] text-hero-subtitle no-underline transition-colors hover:text-white"
          >
            <ArrowRight class="h-3.5 w-3.5 rotate-180" />
            Blog
          </a>
          <h1 class="mb-5 text-white">{data.title}</h1>
          <p class="par-l mb-6 text-hero-subtitle">{data.description}</p>
          <p
            class="mono mb-4 text-[11px] uppercase tracking-[0.12em] text-hero-subtitle"
          >
            {formatBlogDate(data.date)} · {data.categories.join(" · ")} · <span
              class="text-hero-authorLabel">{data.author}</span
            >
          </p>

          <ShareBar title={data.title} slug={entry.id} class="mb-10" />

          {
            embedUrl ? (
              <VideoEmbed
                embedUrl={embedUrl}
                cover={data.cover}
                title={data.title}
                duration={data.duration}
                class="mb-12 aspect-video w-full rounded-3xl border border-homeLicense-border"
              />
            ) : (
              <PostThumbnail
                cover={data.cover}
                alt={data.title}
                hasVideo={hasVideo}
                duration={data.duration}
                playSize="lg"
                loading="eager"
                class="mb-10 aspect-video w-full rounded-3xl border border-homeLicense-border"
              />
            )
          }

          {
            hasVideo && !embedUrl && (
              <a
                href={data.video}
                target="_blank"
                rel="noreferrer noopener"
                class="bg-[#F24664] hover:bg-[#F5546E] mb-12 flex h-12 w-fit items-center gap-x-2 rounded-full px-5 text-white no-underline transition-all duration-300 hover:scale-[1.02] hover:shadow-2xl hover:shadow-[#fbc6cf40]"
              >
                <span class="text-base">Watch the video</span>
                <ArrowRight class="h-4 w-4" />
              </a>
            )
          }

          <div class="blog-prose">
            <Content />
          </div>

          <ShareBar title={data.title} slug={entry.id} class="mt-12" />

          {
            giscus && (
              <section class="mt-16">
                <p class="mono mb-6 text-[11px] uppercase tracking-[0.16em] text-hero-subtitle">
                  Comments
                </p>
                <GiscusComments
                  client:visible
                  repo={giscus.repo}
                  repoId={giscus.repoId}
                  category={giscus.category}
                  categoryId={giscus.categoryId}
                  term={`/blog/${entry.id}`}
                />
              </section>
            )
          }
        </div>
      </article>
    </div>
  </main>
</MainLayout>

<style>
  .mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
  }
</style>

<style is:global>
  @import "../../../styles/blog-article.scss";
</style>
