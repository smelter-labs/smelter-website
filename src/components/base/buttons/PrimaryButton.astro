---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"button"> & { textClass?: string };

const { class: buttonClass, textClass, ...primaryButtonProps } = Astro.props;
---

<button
  class:list={['flex items-center justify-center bg-[#F24664] hover:bg-[#F5546E] px-5 h-12 sm:px-6 sm:h-14 rounded-2xl w-fit shadow-none hover:shadow-[#fbc6cf40] hover:shadow-2xl hover:scale-[1.02] transition-all duration-300', buttonClass]}
  {...primaryButtonProps}>
  <div class:list={["btn-label flex gap-x-1.5 sm:gap-x-3 text-xl text-white justify-center items-center leading-none", textClass]}>
    <slot />
  </div>
</button>

<style>
  /* Optical centering: Aeonik reserves descender space, so text sits high
     inside its line box. Tighten line-height and nudge slotted text down. */
  .btn-label :global(p) {
    line-height: 1;
    transform: translateY(0.045em);
  }
</style>
