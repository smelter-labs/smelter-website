---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"button">;

const { class: buttonClass, ...buttonProps } = Astro.props;
---

<button class="w-fit flex items-center justify-center rounded-2xl h-14 sm:h-17.5 px-6 sm:px-7 bg-[#C2B1E014] border border-[#C2B1E03D] hover:bg-[#C2B1E026] hover:border-[#C2B1E075] shadow-none transition-all hover:scale-[1.02] duration-300" {...buttonProps}>
    <div class="btn-label flex gap-x-1.5 sm:gap-x-3 text-xl text-white justify-center items-center leading-none">
        <slot />
    </div>
</button>

<style>
  /* Optical centering: Aeonik reserves descender space, so text sits high
     inside its line box. Tighten line-height and nudge slotted text down. */
  .btn-label :global(p) {
    line-height: 1;
    transform: translateY(0.045em);
  }
</style>