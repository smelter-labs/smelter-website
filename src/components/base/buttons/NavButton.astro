---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"button">;

const { class: buttonClass, ...buttonProps } = Astro.props;
---
<button class="w-fit flex items-center justify-center rounded-2xl h-10 px-4 bg-[#C2B1E014] border border-[#C2B1E03D] hover:bg-[#C2B1E026] hover:border-[#C2B1E075] shadow-none transition-all hover:scale-[1.02] duration-300" {...buttonProps}>
    <div class="flex gap-x-1.5 sm:gap-x-3 text-md text-white justify-center items-center">
        <slot />
    </div>
</button>