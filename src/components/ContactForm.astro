---
import Select from "./base/Select.astro";
import TextArea from "./base/TextArea.astro";
import TextInput from "./base/TextInput.astro";
import PrimaryButton from "./base/buttons/PrimaryButton.astro";

import ArrowRight from "/public/images/arrow-right.svg";
---

<section
  id="contact"
  class="mx-4 my-10 flex gap-x-28 rounded-4xl border border-form-border bg-mainBackground flex-col px-10 pt-10 pb-4 sm:mx-8 xl:mx-40 lg:flex-row"
>
  <div>
    <h2 class="shrink-0 text-form-header md:mb-4">
      Do you want to use<br/>Smelter?
    </h2>
    <p class="text-form-subtitle">Tell us about your needs and we’ll get back to you in 48 hours</p>
  </div>
  <form class="flex w-full flex-col gap-y-10 mt-12 sm:mt-0" method="POST">
    <div class="flex w-full flex-col">
      <TextInput
        label="Your e-mail"
        type="email"
        name="email"
        placeholder="user@smelter.dev"
        class="aria-[invalid=true]:border-form-error"
        aria-describedby="contact-email-error"
        required
      />
      <p id="contact-email-error" class="mt-2 text-sm text-form-error empty:mt-0" aria-live="polite"></p>
    </div>
    <Select label="Type of inquiry" name="inquiry">
      <option value="demo-request"
        >I'm interested in a demo/trial to see how Smelter works</option
      >
      <option value="question">I have a few questions regarding Smelter</option>
      <option value="feature-request"
        >I need additional features for my project</option
      >
      <option value="enterprise-request"
        >I'm interested in enterprise-level deployment and integration</option
      >
      <option value="unique-application"
        >I have a unique use case in mind and want to discuss it</option
      >
    </Select>
    <div class="flex w-full flex-col">
      <TextArea
        label="Tell us more about your needs"
        name="message"
        class="resize-none aria-[invalid=true]:border-form-error"
        rows="6"
        aria-describedby="contact-message-error"
        required
      />
      <p id="contact-message-error" class="mt-2 text-sm text-form-error empty:mt-0" aria-live="polite"></p>
      <label class="mt-4 flex cursor-pointer items-start gap-x-3 text-form-label">
        <span
          class="mt-1.5 flex shrink-0 rounded-sm has-[[aria-invalid=true]]:outline has-[[aria-invalid=true]]:outline-2 has-[[aria-invalid=true]]:outline-offset-2 has-[[aria-invalid=true]]:outline-form-error"
        >
          <input
            type="checkbox"
            name="privacyConsent"
            aria-describedby="contact-privacyConsent-error"
            required
            class="m-0 size-5 cursor-pointer accent-link"
          />
        </span>
        <span>
          By clicking this, I agree to my data provided above being processed in accordance with the
          <a
            class="text-form-label underline underline-offset-2 hover:text-link"
            href="https://swmansion.com/privacy/policy"
            target="_blank"
            rel="noopener">Privacy Policy</a
          >.
        </span>
      </label>
      <p id="contact-privacyConsent-error" class="mt-2 text-sm text-form-error empty:mt-0" aria-live="polite"></p>
    </div>
    <div class="flex w-full flex-col items-end gap-y-3 sm:w-auto sm:self-end">
      <PrimaryButton
        type="submit"
        class="w-full sm:w-fit disabled:cursor-wait disabled:opacity-60 disabled:hover:scale-100 disabled:hover:shadow-none"
      >
        <p class="par-l">Send the message</p>
        <ArrowRight />
      </PrimaryButton>
      <p id="contact-form-error" class="text-right text-sm text-form-error empty:hidden" role="alert"></p>
      <p class="text-right text-form-border text-xs">
        This site is protected by reCAPTCHA and the Google
        <a class="text-form-border text-xs" href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a> and
        <a class="text-form-border text-xs" href="https://policies.google.com/terms" target="_blank" rel="noopener noreferrer">Terms of Service</a> apply.
      </p>
    </div>
  </form>
</section>

<script>
  import { initContactForm } from "../utils/contactFormClient";

  document.addEventListener("astro:page-load", initContactForm);
</script>
