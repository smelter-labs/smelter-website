---
import PrimaryButton from "@components/base/buttons/PrimaryButton.astro";
import ArrowRight from "/public/images/arrow-right.svg";
---

<section id="pricing" class="mb-28 px-4 sm:px-8 license-scroll-margin">
  <div class="mx-auto flex max-w-[1040px] flex-col">
    <div class="mb-12 flex flex-col items-center text-center">
      <h2 class="mb-5 text-homeLicense-header">
        Run it yourself.<br />License it when you <span
          style="background:linear-gradient(120deg,#F78D9E,#C2B1E0);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent"
          >scale</span
        >.
      </h2>

    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <!-- Community License -->
      <div
        class="flex h-full flex-col rounded-4xl border border-homeLicense-border bg-explanation-background p-8"
      >
        <span
          class="mono mb-6 inline-block w-fit rounded-md border border-homeLicense-border px-2.5 py-1 text-[10px] uppercase tracking-[0.12em] text-hero-subtitle"
        >
          Free · Self-hosted
        </span>
        <h3 class="text-homeLicense-header">Community License</h3>
        <p class="par-s text-hero-subtitle">
          For hobbyists and small-to-medium projects
        </p>

        <div class="my-6 h-px bg-homeLicense-border"></div>

        <div class="flex flex-col gap-5">
          <div>
            <p
              class="mono mb-1.5 text-[11px] uppercase tracking-[0.12em] text-hero-subtitle"
            >
              Offline processing
            </p>
            <p class="m-0 text-white">Unlimited</p>
          </div>
          <div>
            <p
              class="mono mb-2 text-[11px] uppercase tracking-[0.12em] text-hero-subtitle"
            >
              Live processing
            </p>
            <ul class="m-0 flex list-none flex-col gap-1.5 p-0">
              <li class="flex items-start gap-2.5">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-[#8471C1]"></span>
                <span class="text-white">Up to 50 employees</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-[#8471C1]"></span>
                <span class="text-white">Up to 10k viewers</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-[#8471C1]"></span>
                <span class="text-white">Up to 50 machines</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="mt-auto pt-8">
          <a
            href="/fundamentals/getting-started"
            style="text-decoration: none; color: inherit"
          >
            <PrimaryButton class="max-h-14">
              <p class="m-0">Start building</p>
              <ArrowRight class="w-4 h-4" />
            </PrimaryButton>
          </a>
        </div>
      </div>

      <!-- Commercial License -->
      <div class="gradient-light-4 flex h-full rounded-4xl p-px">
        <div
          class="flex h-full w-full flex-col rounded-[calc(2rem-1px)] bg-explanation-background p-8"
        >
          <span
            class="mono mb-6 inline-block w-fit rounded-md bg-[#493880] px-2.5 py-1 text-[10px] uppercase tracking-[0.12em] text-white"
          >
            Commercial · Self-hosted
          </span>
          <h3 class="text-homeLicense-header">Commercial License</h3>
          <p class="par-s text-hero-subtitle">
            For enterprise-grade applications
          </p>

          <div class="my-6 h-px bg-homeLicense-border"></div>

          <div class="flex flex-col gap-5">
            <div>
              <p
                class="mono mb-1.5 text-[11px] uppercase tracking-[0.12em] text-hero-subtitle"
              >
                Offline processing
              </p>
              <p class="m-0 text-white">Unlimited</p>
            </div>
            <div>
              <p
                class="mono mb-1.5 text-[11px] uppercase tracking-[0.12em] text-hero-subtitle"
              >
                Live processing
              </p>
              <p class="m-0 text-white">Unlimited</p>
            </div>
            <div>
              <p
                class="mono mb-1.5 text-[11px] uppercase tracking-[0.12em] text-hero-subtitle"
              >
                Priority support
              </p>
              <p class="m-0 text-white">
                Custom integrations, new features, long-term support
              </p>
            </div>
          </div>

          <div class="mt-auto pt-4">
            <p class="mono mb-5 text-[14px] text-hero-subtitle">
              <span class="text-white">90-day free trial</span> · no credit card
            </p>
            <a href="#contact" style="text-decoration: none; color: inherit">
              <PrimaryButton class="max-h-14">
                <p class="m-0">Start 90-day trial</p>
                <ArrowRight class="w-4 h-4" />
              </PrimaryButton>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Managed Service -->
    <div class="gradient-red-1 mt-6 rounded-4xl p-px">
      <div
        class="rounded-[calc(2rem-1px)] bg-explanation-background px-8 py-8 sm:px-10"
      >
        <div
          class="flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:gap-8"
        >
          <div class="flex-1">
            <p
              class="mono mb-2 text-[11px] uppercase tracking-[0.14em] text-hero-docsGradientFrom"
            >
              Managed Service
            </p>
            <p class="m-0 text-white">
              Don't want to run infrastructure? Software Mansion hosts and
              operates Smelter for you via Fishjam — no server required.
            </p>
          </div>
          <a
            href="https://fishjam.swmansion.com/real-time-composition"
            target="_blank"
            rel="noreferrer noopener"
            style="text-decoration: none; color: inherit"
            class="shrink-0"
          >
            <PrimaryButton class="max-h-14">
              <p class="m-0">Get Early Access</p>
              <ArrowRight class="w-4 h-4" />
            </PrimaryButton>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
  }

  .license-scroll-margin {
    scroll-margin-top: 10vh;
  }
  @supports (scroll-margin-top: 10dvh) {
    .license-scroll-margin {
      scroll-margin-top: 10dvh;
    }
  }
</style>
