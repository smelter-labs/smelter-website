---
import { Image } from "astro:assets";

import type { ImageMetadata } from "astro";

interface Props {
  header: string;
  subHeader: string;
  image: ImageMetadata;
}

const { header, subHeader, image } = Astro.props;
---

<div id="useCaseTile" class:list={["sticky top-28 items-center"]}>
  <div
    class:list={"w-full rounded-[calc(2rem-1px)] bg-useCases-tileBackgroundOpacity border-gradient"}
  >
    <div
      class="-z-10 bg-useCases-tileBackground rounded-[calc(2rem-1px)] h-full w-full absolute"
    >
      <div
        id="gradient"
        class="w-[256px] h-[72px] absolute left-1/2 top-[-36px] -z-10 -translate-x-1/2 use-case-tile-gradient"
      >
      </div>
    </div>
    <div
      class="flex flex-col items-center gap-6 p-6 sm:flex-row sm:gap-8 sm:p-10"
    >
      <div
        class="flex flex-1 flex-col gap-y-2 text-center sm:text-left"
      >
        <h3 class="text-useCases-tileHeader">{header}</h3>
        <p class="par-l text-useCases-tileSubheader">{subHeader}</p>
      </div>
      <Image
        src={image}
        alt={header}
        class="aspect-video w-full rounded-2xl sm:w-1/2 sm:shrink-0"
      />
    </div>
  </div>
</div>
