---
const mono = "ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace";

// Factual signal badges only. No license / version badge on purpose:
// Smelter ships under Software Mansion's Terms of Service (tiered usage),
// not a permissive OSS license, so an "Apache 2.0" badge would be wrong.
const badges = [
  "Real-time compositing",
  "TypeScript · Elixir · HTTP",
  "WASM · WebGL · Docker",
] as const;

const pillClass = "rounded-lg border border-white/15 px-3 py-1.5 text-hero-subtitle";
---

<div
  class="flex flex-wrap items-center gap-2.5 text-sm"
  style={`font-family:${mono}`}
>
  {badges.map((badge) => <span class={pillClass}>{badge}</span>)}
</div>
