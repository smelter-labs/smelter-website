---
import type { CollectionEntry } from "astro:content";
import ArrowRight from "/public/images/arrow-right.svg";
import PostThumbnail from "./PostThumbnail.astro";
import { formatBlogDate } from "./blogHelpers";

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const { data } = entry;
const hasVideo = Boolean(data.video);
const href = `/blog/${entry.id}`;
---

<a
  href={href}
  class="blog-featured group block rounded-4xl border border-homeLicense-border bg-explanation-background p-3 transition-colors duration-300 hover:border-white/40 sm:p-4"
>
  <div class="grid grid-cols-1 gap-3 sm:gap-4 lg:grid-cols-2">
    <PostThumbnail
      cover={data.cover}
      alt={data.title}
      hasVideo={hasVideo}
      duration={data.duration}
      playSize="lg"
      loading="eager"
      class="aspect-video w-full rounded-[calc(2rem-0.75rem)]"
    />

    <div class="flex flex-col justify-center p-4 sm:p-6 lg:p-8">
      <p
        class="mono mb-4 text-[11px] uppercase tracking-[0.14em] text-hero-docsGradientFrom"
      >
        Featured · {data.category}
      </p>
      <h2 class="mb-4 text-white">{data.title}</h2>
      <p class="par-s m-0 mb-6 text-hero-subtitle">{data.description}</p>

      <p class="mono mb-6 text-[11px] uppercase tracking-[0.12em] text-hero-subtitle">
        {formatBlogDate(data.date)} · {data.author}
      </p>

      <span
        class="bg-[#F24664] group-hover:bg-[#F5546E] flex h-12 w-fit items-center gap-x-2 rounded-full px-5 text-white transition-all duration-300 group-hover:scale-[1.02] group-hover:shadow-2xl group-hover:shadow-[#fbc6cf40]"
      >
        <span class="text-base">{hasVideo ? "Watch" : "Read more"}</span>
        <ArrowRight class="h-4 w-4" />
      </span>
    </div>
  </div>
</a>

<style>
  .mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
  }
</style>
